{
  "name": "labelforge",
  "version": "1.17.0",
  "description": "Stampa etichette ZPL su stampanti Zebra (es. ZD410) via rete (IP) o USB/Windows, con template dinamici, editor visuale e interfaccia desktop.",
  "main": "gui/main.js",
  "type": "commonjs",
  "bin": {
    "zlabel": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "gui": "electron .",
    "cli": "node cli.js",
    "serve": "node cli.js serve",
    "watch": "node cli.js watch",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "pack:exe": "electron-packager . \"LabelForge\" --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist-app --overwrite --app-version=1.17.0"
  },
  "keywords": [
    "zebra",
    "zd410",
    "zpl",
    "tspl",
    "label",
    "printer",
    "etichette",
    "barcode",
    "qrcode",
    "datamatrix",
    "electron"
  ],
  "author": "dextsamu",
  "license": "MIT",
  "homepage": "https://dextsamu.github.io/labelforge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dextsamu/labelforge.git"
  },
  "bugs": {
    "url": "https://github.com/dextsamu/labelforge/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.labelforge",
    "productName": "LabelForge",
    "files": [
      "gui/**/*",
      "lib/**/*",
      "scripts/**/*",
      "templates/**/*",
      "cli.js"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabelForge"
    }
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "qrcode": "^1.5.4"
  }
}
